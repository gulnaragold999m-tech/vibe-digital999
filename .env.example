# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env никому не показывайте и не выкладывайте в интернет.

# Токен бота, который присылает заявки.
# Можно взять у @BotFather или переиспользовать бота Джарвис:
# его токен лежит в переменных окружения проекта Джарвиса на Amvera
# под именем TELEGRAM_BOT_TOKEN.
BOT_TOKEN=

# Ваш числовой ID в Telegram или ID рабочего чата, куда падают заявки.
# У Джарвиса та же величина называется ADMIN_ID.
CHAT_ID=

# ── Бот в Telegram ──────────────────────────────────────────────
# Тот же ассистент, что в чате на сайте и во ВКонтакте, только вход
# через Telegram. Пусто — сайт и ВК работают как раньше.
#
# ВАЖНО: здесь нужен ОТДЕЛЬНЫЙ бот от @BotFather, не тот, что в BOT_TOKEN.
# Один токен слушать может только одно приложение: если два процесса
# одновременно позовут getUpdates с одним токеном, Telegram ответит
# 409 Conflict и перестанут работать оба. Токен @GranatJarvis_bot уже
# слушает приложение соседнего проекта.
#
# При этом BOT_TOKEN выше остаётся прежним: он только ОТПРАВЛЯЕТ вам
# заявки, а отправлять могут сколько угодно приложений — конфликт
# возникает лишь у того, кто слушает.
TG_BOT_TOKEN=

# ── ВКонтакте ───────────────────────────────────────────────────
# Второй канал для заявок и бот в сообществе. Если оставить пустыми,
# сайт работает как раньше — только Telegram.

# Ключ доступа сообщества: Сообщество → Управление → Работа с API →
# Ключи доступа → Создать ключ. Отметить две галочки:
#   «Сообщения сообщества»   — читать и писать сообщения;
#   «Управление сообществом» — чтобы бот сам включил Long Poll при запуске.
VK_TOKEN=

# Куда слать заявки: ваш личный номер в ВК (цифры из адреса vk.com/idXXXXX).
# Важно: сначала напишите своему сообществу любое сообщение со своей
# страницы, иначе ВК запретит ему писать вам первым (ошибка 901).
VK_PEER_ID=

# Номер сообщества без минуса — нужен боту, чтобы читать сообщения.
# Без него заявки в ВК всё равно уходят, но бот не отвечает посетителям.
VK_GROUP_ID=

# ── Почта ───────────────────────────────────────────────────────
# Третий канал заявок. Telegram и ВК — оба мессенджеры и оба чужие;
# письмо остаётся в ящике, видно с любого устройства и не тонет
# в ленте чатов. Пусто — работают только Telegram и ВК.

# Куда слать заявки. Несколько адресов — через запятую.
MAIL_TO=

# Ящик, ОТ которого уходит письмо. Он же логин на почте.
SMTP_USER=

# Пароль приложения, НЕ обычный пароль от почты. Взять здесь:
# id.yandex.ru → Безопасность → Пароли приложений → Почта.
# Такой пароль даёт доступ только к отправке писем и отзывается
# отдельно, не трогая основной пароль.
SMTP_PASS=

# Необязательно. По умолчанию smtp.yandex.ru и порт 465.
# Внимание: зарубежный почтовый сервер (Gmail, Mailgun) — это
# трансграничная передача персональных данных со всеми последствиями
# из блока про LLM_BASE_URL ниже.
SMTP_HOST=
SMTP_PORT=

# Подпись источника в сообщении. Нужна, если бот общий с другим сайтом.
SITE_NAME=vibe-digital999.ru

# Порт. Локально можно не трогать.
PORT=3000

# ─── ИИ-ассистент в чате ──────────────────────────────────────────────
# Ключ провайдера модели. В Amvera: раздел LLM в кабинете.
# Без ключа чат не работает, остальной сайт работает как обычно.
LLM_API_KEY=

# ВАЖНО ПРО ЗАКОН. По умолчанию (переменная пустая) запросы идут на
# инференс Amvera — это Россия, и именно так написано в разделе 4
# политики конфиденциальности.
#
# Если вписать сюда зарубежный адрес, например
# https://api.anthropic.com/v1, то текст диалога вместе с именем и
# телефоном посетителя поедет за границу. Тогда обязательно:
#   1. Поправить раздел 5 политики — указать реального получателя данных.
#   2. Подать уведомление о трансграничной передаче в Роскомнадзор.
#      Оно подаётся отдельно от общего уведомления оператора, ст. 12 152-ФЗ.
# При чужом адресе сервер пишет предупреждение в журнал при каждом запуске.
LLM_BASE_URL=

# Модель. По умолчанию gpt-5. Список: GET {LLM_BASE_URL}/models
LLM_MODEL=

# Формат запроса: openai (по умолчанию) или anthropic.
LLM_FORMAT=

# Ключ для выгрузки заявок по адресу /api/leads?key=...
# Пока не задан, адрес отвечает 404: внутри персональные данные людей.
LEADS_KEY=
